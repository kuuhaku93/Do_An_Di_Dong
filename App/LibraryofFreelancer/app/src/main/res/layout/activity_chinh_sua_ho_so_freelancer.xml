<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1F1E1E"
    tools:context=".view.freelancer.ChinhSuaHoSoFreelancerActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Nút quay lại -->

        <Button
            android:id="@+id/btn_chinhSuaChungNhan_ChinhSuaHoSo_freelancer3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:backgroundTint="#0C9300"
            android:text="Chỉnh sửa chứng nhận"
            android:textSize="24sp"
            app:layout_constraintEnd_toEndOf="@+id/txt_SDT_ChinhSuaHoSo"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toStartOf="@+id/txt_SDT_ChinhSuaHoSo"
            app:layout_constraintTop_toBottomOf="@+id/btn_chinhSuaKyNang_ChinhSuaHoSo_freelancer" />

        <Button
            android:id="@+id/btn_chinhSuaKyNang_ChinhSuaHoSo_freelancer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:backgroundTint="#0C9300"
            android:text="Chỉnh sửa kỹ năng"
            android:textSize="24sp"
            app:layout_constraintEnd_toEndOf="@+id/txt_SDT_ChinhSuaHoSo"
            app:layout_constraintStart_toStartOf="@+id/txt_SDT_ChinhSuaHoSo"
            app:layout_constraintTop_toBottomOf="@+id/txt_SDT_ChinhSuaHoSo" />

        <ImageButton
            android:id="@+id/btn_QuayLai_chinhSuaHoSo_freelancer"
            android:layout_width="68dp"
            android:layout_height="53dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:background="@null"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/baseline_arrow_back_24"
            app:tint="#FFFFFF" />

        <!-- Họ và tên -->
        <TextView
            android:id="@+id/textView13"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:text="Họ và tên"
            android:textColor="#FFFFFF"
            app:layout_constraintBottom_toTopOf="@+id/txt_HovaTen_ChinhSuaHoSo"
            app:layout_constraintStart_toStartOf="@+id/txt_HovaTen_ChinhSuaHoSo" />

        <EditText
            android:id="@+id/txt_HovaTen_ChinhSuaHoSo"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_marginStart="32dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="32dp"
            android:background="@drawable/custom_txt"
            android:ems="10"
            android:inputType="text"
            android:paddingLeft="20dp"
            android:text="Họ và tên"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/img_avatar_chinhSuaHoSo_freelancer" />

        <!-- Email -->
        <TextView
            android:id="@+id/textView14"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:text="Email"
            android:textColor="#FFFFFF"
            app:layout_constraintBottom_toTopOf="@+id/txt_Email_ChinhSuaHoSo"
            app:layout_constraintStart_toStartOf="@+id/txt_Email_ChinhSuaHoSo" />

        <EditText
            android:id="@+id/txt_Email_ChinhSuaHoSo"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_marginStart="32dp"
            android:layout_marginTop="30dp"
            android:layout_marginEnd="32dp"
            android:background="@drawable/custom_txt"
            android:ems="10"
            android:inputType="textEmailAddress"
            android:paddingLeft="20dp"
            android:text="Email"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txt_HovaTen_ChinhSuaHoSo" />

        <!-- SĐT -->
        <TextView
            android:id="@+id/textView15"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginBottom="5dp"
            android:text="Số điện thoại"
            android:textColor="#FFFFFF"
            app:layout_constraintBottom_toTopOf="@+id/txt_SDT_ChinhSuaHoSo"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Học vấn -->
        <EditText
            android:id="@+id/txt_SDT_ChinhSuaHoSo"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_marginStart="32dp"
            android:layout_marginTop="30dp"
            android:layout_marginEnd="32dp"
            android:background="@drawable/custom_txt"
            android:ems="10"
            android:inputType="phone"
            android:paddingLeft="20dp"
            android:text="Số Điện Thoại"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txt_Email_ChinhSuaHoSo" />

        <!-- Năm học -->

        <!-- Mô tả -->

        <TextView
            android:id="@+id/textView17"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:text="Mô tả"
            android:textColor="#FFFFFF"
            app:layout_constraintBottom_toTopOf="@+id/txt_moTa_ChinhSuaHoSo_freelancer"
            app:layout_constraintStart_toStartOf="@+id/txt_moTa_ChinhSuaHoSo_freelancer" />

        <EditText
            android:id="@+id/txt_moTa_ChinhSuaHoSo_freelancer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="30dp"
            android:layout_marginEnd="32dp"
            android:background="@drawable/custum_txt_mota"
            android:ems="10"
            android:gravity="start"
            android:inputType="textMultiLine"
            android:minHeight="100dp"
            android:paddingLeft="20dp"
            android:text="Mô tả chi tiết"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btn_chinhSuaChungNhan_ChinhSuaHoSo_freelancer3" />

        <Button
            android:id="@+id/btn_Luu_ChinhSuaHoSo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:backgroundTint="#0C9300"
            android:text="Lưu"
            android:textSize="20sp"
            app:layout_constraintEnd_toEndOf="@+id/txt_moTa_ChinhSuaHoSo_freelancer"
            app:layout_constraintTop_toBottomOf="@id/txt_moTa_ChinhSuaHoSo_freelancer" />

        <ImageView
            android:id="@+id/img_avatar_chinhSuaHoSo_freelancer"
            android:layout_width="120dp"
            android:layout_height="120dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/btn_QuayLai_chinhSuaHoSo_freelancer"
            tools:srcCompat="@tools:sample/avatars" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>