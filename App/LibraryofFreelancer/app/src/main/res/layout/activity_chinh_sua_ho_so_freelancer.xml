<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1F1E1E"
    tools:context=".view.ChinhSuaHoSoFreelancerActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Nút quay lại -->
        <ImageButton
            android:id="@+id/btn_QuayLaiTrangHoSo2"
            android:layout_width="68dp"
            android:layout_height="53dp"
            android:layout_marginStart="32dp"
            android:layout_marginTop="34dp"
            android:background="@null"
            app:srcCompat="@drawable/baseline_arrow_back_24"
            app:tint="#6C6C6C"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Họ và tên -->
        <TextView
            android:id="@+id/textView13"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Họ và tên"
            android:textColor="#FFFFFF"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_QuayLaiTrangHoSo2"
            android:layout_marginStart="32dp"
            android:layout_marginTop="32dp"/>

        <EditText
            android:id="@+id/txt_HovaTenTrangChinhSuaHoSo"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:background="@drawable/custom_txt"
            android:ems="10"
            android:inputType="text"
            android:paddingLeft="20dp"
            android:text="Họ và tên"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textView13"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:layout_marginTop="8dp"/>

        <!-- Email -->
        <TextView
            android:id="@+id/textView14"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Email"
            android:textColor="#FFFFFF"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txt_HovaTenTrangChinhSuaHoSo"
            android:layout_marginStart="32dp"
            android:layout_marginTop="16dp"/>

        <EditText
            android:id="@+id/txt_EmailTrangChinhSuaHoSo"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:background="@drawable/custom_txt"
            android:ems="10"
            android:inputType="textEmailAddress"
            android:paddingLeft="20dp"
            android:text="Email"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textView14"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:layout_marginTop="8dp"/>

        <!-- SĐT -->
        <TextView
            android:id="@+id/textView15"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SĐT"
            android:textColor="#FFFFFF"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txt_EmailTrangChinhSuaHoSo"
            android:layout_marginStart="32dp"
            android:layout_marginTop="16dp"/>

        <EditText
            android:id="@+id/txt_SDTTrangChinhSuaHoSo"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:background="@drawable/custom_txt"
            android:ems="10"
            android:inputType="phone"
            android:paddingLeft="20dp"
            android:text="Số Điện Thoại"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textView15"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:layout_marginTop="8dp"/>

        <!-- Học vấn -->
        <TextView
            android:id="@+id/textView16"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Học vấn"
            android:textColor="#FFFFFF"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txt_SDTTrangChinhSuaHoSo"
            android:layout_marginStart="32dp"
            android:layout_marginTop="16dp"/>

        <EditText
            android:id="@+id/txt_NganhvaNoiHocTrangChinhSuaHoSo"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:background="@drawable/custom_txt"
            android:ems="10"
            android:inputType="text"
            android:paddingLeft="20dp"
            android:text="Ngành và nơi học"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textView16"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:layout_marginTop="8dp"/>

        <!-- Năm học -->
        <EditText
            android:id="@+id/txt_NamChinhSuaHoSo"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:background="@drawable/custom_txt"
            android:ems="10"
            android:inputType="text"
            android:paddingLeft="20dp"
            android:text="Năm bắt đầu - Năm kết thúc"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txt_NganhvaNoiHocTrangChinhSuaHoSo"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:layout_marginTop="8dp"/>

        <!-- Mô tả -->

        <TextView
            android:id="@+id/textView17"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="44dp"
            android:layout_marginTop="4dp"
            android:text="Mô tả"
            android:textColor="#FFFFFF"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txt_NamChinhSuaHoSo" />

        <EditText
            android:id="@+id/txt_HovaTenTrangChinhSuaHoSo6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="32dp"
            android:background="@drawable/custum_txt_mota"
            android:ems="10"
            android:inputType="textMultiLine"
            android:minHeight="100dp"
            android:paddingLeft="20dp"
            android:text="Mô tả chi tiết"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textView17" />

        <Button
            android:id="@+id/btn_Luu_ChinhSuaHoSo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="#0C9300"
            android:text="Lưu"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.869"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txt_HovaTenTrangChinhSuaHoSo6" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>