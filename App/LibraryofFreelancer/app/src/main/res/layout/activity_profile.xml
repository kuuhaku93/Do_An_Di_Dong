<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1C1B1B"
    tools:context=".view.freelancer.HoSoFreelancerActivity">


    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#141414"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconTint="@color/bottom_nav_icon_selector"
        app:itemTextColor="@color/bottom_nav_text_selector" />


    <!-- ScrollView chứa nội dung -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Header + Avatar -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="220dp">

                <!-- Ảnh nền header -->
                <ImageView
                    android:id="@+id/imageView11"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:adjustViewBounds="true"
                    android:scaleType="centerCrop"
                    app:srcCompat="@drawable/bg_profile" />

                <!-- Avatar chồng lên header -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/image_anhdaidien"
                    android:layout_width="145dp"
                    android:layout_height="145dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="70dp"
                    android:scaleType="centerCrop"
                    app:srcCompat="@drawable/about"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CircleImage"
                    app:strokeWidth="2dp"
                    />

                <ImageButton
                    android:id="@+id/btn_CaiDat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="12dp"
                    android:background="#0C9300"
                    app:srcCompat="@drawable/baseline_settings_24" />

                <ImageButton
                    android:id="@+id/btn_ChinhSuaHoSo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#0C9300"
                    android:layout_gravity="end"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="50dp"
                    app:srcCompat="@drawable/outline_border_color_24" />

            </FrameLayout>

            <!-- Tên -->
            <TextView
                android:id="@+id/txt_HovaTen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Adam"
                android:textSize="28sp"
                android:textColor="#FFFFFF"
                android:textAlignment="center"
                android:layout_marginTop="12dp" />

            <!-- Mô tả -->
            <TextView
                android:id="@+id/txt_mota"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lorem ipsum dolor sit amet, consectetur adipiscing elit..."
                android:textSize="14sp"
                android:textColor="#CCCCCC"
                android:textAlignment="center"
                android:layout_marginTop="8dp" />

            <!-- Email -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">
                <TextView
                    android:id="@+id/label_email"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Email:"
                    android:textColor="#0C9300"
                    android:textSize="16sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

                <TextView
                    android:id="@+id/txt_email"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="explam@gmail.com"
                    android:textColor="#FFFFFF"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBaseline_toBaselineOf="@id/label_email"/>
            </androidx.constraintlayout.widget.ConstraintLayout>


            <!-- SĐT -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <!-- Label SĐT bên trái -->
                <TextView
                    android:id="@+id/label_sdt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SĐT:"
                    android:textColor="#0C9300"
                    android:textSize="16sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

                <!-- Nội dung SĐT bên phải hẳn -->
                <TextView
                    android:id="@+id/txt_sdt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0987654321"
                    android:textColor="#FFFFFF"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBaseline_toBaselineOf="@id/label_sdt"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Kỹ năng -->
            <TextView
                android:id="@+id/txt_kynang"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Kỹ năng"
                android:textColor="#0C9300"
                android:textSize="18sp"
                android:layout_marginTop="24dp" />

            <!-- Kinh nghiệm -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rcv_kynang"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/txt_kinhnghiem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Kinh nghiệm"
                android:textColor="#0C9300"
                android:textSize="18sp"
                android:layout_marginTop="24dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rcv_kinhnghiem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <!-- Học vấn -->
            <TextView
                android:id="@+id/txt_hocvan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Học vấn"
                android:textColor="#0C9300"
                android:textSize="18sp"
                android:layout_marginTop="24dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rcv_hocvan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="20dp"
                android:padding="8dp">

                <!-- Ô 1: Tỷ lệ hoàn thành -->
                <LinearLayout
                    android:id="@+id/o_ty_le_hoan_thanh"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_card_profile"
                    android:padding="12dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/o_danh_gia"
                    app:layout_constraintHorizontal_weight="1">

                    <!-- Vòng tròn tiến độ -->
                    <ProgressBar
                        android:id="@+id/vong_tron_ty_le"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:indeterminate="false"
                        android:max="100"
                        android:progress="86"
                        android:rotation="270"
                        android:progressDrawable="@drawable/circle_progress_drawable" />

                    <TextView
                        android:id="@+id/txt_ty_le"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="86%"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:id="@+id/nhan_ty_le"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Tỷ lệ hoàn thành"
                        android:textAlignment="center"
                        android:textColor="#CCCCCC"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Ô 2: Đánh giá -->
                <LinearLayout
                    android:id="@+id/o_danh_gia"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_card_profile"
                    android:padding="12dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintStart_toEndOf="@id/o_ty_le_hoan_thanh"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/o_cong_viec"
                    app:layout_constraintHorizontal_weight="1">

                    <LinearLayout
                        android:id="@+id/hang_danh_gia"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/so_danh_gia"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4"
                            android:textColor="#FFD700"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/sao_danh_gia"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="★"
                            android:textColor="#FFD700"
                            android:textSize="18sp"
                            android:layout_marginStart="4dp"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/nhan_danh_gia"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Đánh giá"
                        android:textColor="#CCCCCC"
                        android:textSize="14sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Ô 3: Công việc hoàn thành -->
                <LinearLayout
                    android:id="@+id/o_cong_viec"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_card_profile"
                    android:padding="12dp"
                    app:layout_constraintStart_toEndOf="@id/o_danh_gia"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_weight="1">

                    <TextView
                        android:id="@+id/so_cong_viec"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="56"
                        android:textColor="#00FF00"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/nhan_cong_viec"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Công việc hoàn thành"
                        android:textAlignment="center"
                        android:textColor="#CCCCCC"
                        android:textSize="14sp" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                    android:id="@+id/so_sao_review"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4"
                    android:textColor="#919191"
                    android:textSize="30sp" />

                <TextView
                    android:id="@+id/sao_review"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="★"
                    android:textColor="#919191"
                    android:textSize="30sp"
                    android:layout_marginStart="4dp"/>

                <TextView
                    android:id="@+id/so_review"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3 review"
                    android:textColor="#FFFFFF"
                    android:textSize="30sp"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rcv_danh_gia"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />


        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>