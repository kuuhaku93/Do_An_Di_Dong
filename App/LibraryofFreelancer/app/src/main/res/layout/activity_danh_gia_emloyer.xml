<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1B1C1C"
    tools:context=".view.freelancer.DanhGiaEmloyerActivity">

    <TextView
        android:id="@+id/textView7"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Đánh giá công ty"
        android:textColor="#0D9501"
        android:textSize="36sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txt_tenCongTy_danhGiaEmployer_Freelancer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="20dp"
        android:text="Employer"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.151"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView7" />

    <TextView
        android:id="@+id/txt_tenCongViec_danhGiaEmployer_Freelancer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Name Job"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="@+id/txt_tenCongTy_danhGiaEmployer_Freelancer"
        app:layout_constraintHorizontal_bias="0.124"
        app:layout_constraintStart_toStartOf="@+id/txt_tenCongTy_danhGiaEmployer_Freelancer"
        app:layout_constraintTop_toBottomOf="@+id/txt_tenCongTy_danhGiaEmployer_Freelancer" />

    <RatingBar
        android:id="@+id/rb_rating_danhGiaEmployer_Freelancer"
        android:layout_width="241dp"
        android:layout_height="48dp"
        android:layout_marginTop="50dp"
        android:numStars="5"
        android:progressTint="#FFC300"
        android:rating="2.5"
        android:stepSize="0.5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txt_tenCongViec_danhGiaEmployer_Freelancer" />

    <TextView
        android:id="@+id/textView10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="Viết đánh giá"
        android:textColor="#FFFAFA"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="@+id/txt_danhGia_DanhGiaEmployer_Freelancer"
        app:layout_constraintTop_toBottomOf="@+id/rb_rating_danhGiaEmployer_Freelancer" />

    <EditText
        android:id="@+id/txt_danhGia_DanhGiaEmployer_Freelancer"
        android:layout_width="wrap_content"
        android:layout_height="246dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/custum_txt_mota"
        android:ems="10"
        android:gravity="start"
        android:inputType="text"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:textAlignment="textStart"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.492"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView10" />

    <Button
        android:id="@+id/btn_danhGia_danhGiaEmployer_Freelancer"
        android:layout_width="342dp"
        android:layout_height="68.61dp"
        android:layout_marginTop="24dp"
        android:backgroundTint="#0C9300"
        android:text="ĐĂNG"
        android:textColorLink="#0C9300"
        android:textSize="16dp"
        app:layout_constraintEnd_toEndOf="@+id/txt_danhGia_DanhGiaEmployer_Freelancer"
        app:layout_constraintStart_toStartOf="@+id/txt_danhGia_DanhGiaEmployer_Freelancer"
        app:layout_constraintTop_toBottomOf="@+id/txt_danhGia_DanhGiaEmployer_Freelancer" />

    <ImageButton
        android:id="@+id/btn_back_dangGiaEmployer_freelancer"
        android:layout_width="50dp"
        android:layout_height="52dp"
        android:backgroundTint="#1B1C1C"
        android:tint="#FFFFFF"
        app:layout_constraintEnd_toStartOf="@+id/textView7"
        app:layout_constraintTop_toTopOf="@+id/textView7"
        app:srcCompat="@drawable/baseline_arrow_back_24" />

    <TextView
        android:id="@+id/textView11"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="Số sao đánh giá:"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@+id/rb_rating_danhGiaEmployer_Freelancer"
        app:layout_constraintEnd_toEndOf="@+id/rb_rating_danhGiaEmployer_Freelancer"
        app:layout_constraintStart_toStartOf="@+id/txt_tenCongViec_danhGiaEmployer_Freelancer" />
</androidx.constraintlayout.widget.ConstraintLayout>