<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1C1B1B"
    tools:context=".view.freelancer.DangKyCongViecActivity">

    <!-- Guideline chia màn hình theo chiều dọc (30% trên) -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline30"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.3"
        android:orientation="horizontal"/>

    <!-- Phần xanh (chiếm 30% trên cùng) -->
    <View
        android:id="@+id/view_xanh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#0C9300"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/guideline30"/>

    <!-- Phần đen (chiếm 70% còn lại) -->
    <View
        android:id="@+id/view_den"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#1C1B1B"
        app:layout_constraintTop_toBottomOf="@id/guideline30"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="375dp"
        android:layout_height="599dp"
        android:layout_marginTop="88dp"
        android:background="#1C1B1B"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.495"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btn_QuayLaiTrangChiTietCongViec"
            android:layout_width="68dp"
            android:layout_height="53dp"
            android:layout_marginStart="4dp"
            android:layout_marginTop="4dp"
            android:background="@null"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/baseline_arrow_back_24"
            app:tint="#6C6C6C" />

        <TextView
            android:id="@+id/textView18"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Đơn đăng ký"
            android:textColor="#ffff"
            android:textSize="34sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.054"
            app:layout_constraintStart_toEndOf="@+id/btn_QuayLaiTrangChiTietCongViec"
            app:layout_constraintTop_toTopOf="parent" />

        <EditText
            android:id="@+id/txt_mucluongmongmuon_trangdangkycongviec"
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/custom_txt"
            android:ems="10"
            android:hint="Mức lương mong muốn"
            android:inputType="phone"
            android:paddingLeft="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.515"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView18" />

        <EditText
            android:id="@+id/txt_motacongviec"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:background="@drawable/custum_txt_mota"
            android:ems="10"
            android:gravity="start"
            android:hint="Nhập điều muốn nói với nhà tuyển dụng"
            android:inputType="text"
            android:paddingLeft="10dp"
            android:paddingTop="10dp"
            app:layout_constraintEnd_toEndOf="@+id/txt_mucluongmongmuon_trangdangkycongviec"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toStartOf="@+id/txt_mucluongmongmuon_trangdangkycongviec"
            app:layout_constraintTop_toBottomOf="@+id/txt_mucluongmongmuon_trangdangkycongviec" />

        <Button
            android:id="@+id/btn_ungtuyen"
            android:layout_width="318dp"
            android:layout_height="64dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="#0C9300"
            android:text="ỨNG TUYỂN"
            android:textSize="20sp"
            app:layout_constraintEnd_toEndOf="@+id/txt_motacongviec"
            app:layout_constraintHorizontal_bias="0.496"
            app:layout_constraintStart_toStartOf="@+id/txt_motacongviec"
            app:layout_constraintTop_toBottomOf="@+id/txt_motacongviec" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>