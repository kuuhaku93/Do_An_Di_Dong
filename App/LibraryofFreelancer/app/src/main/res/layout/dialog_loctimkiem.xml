<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1C1B1B">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dialog_them_skill_profile"
        android:layout_width="366dp"
        android:layout_height="569dp"
        android:background="@drawable/alerdialog_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/textView3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Ngành Nghề"
            android:textColor="#0C9300"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.055"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textView11"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Loại Hình"
            android:textColor="#0C9300"
            app:layout_constraintEnd_toEndOf="@+id/rcv_KyNangTrangHoSo"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="@+id/rcv_KyNangTrangHoSo"
            app:layout_constraintTop_toBottomOf="@+id/rcv_KyNangTrangHoSo" />

        <TextView
            android:id="@+id/textView12"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:text="Ngôn ngữ"
            android:textColor="#0C9300"
            app:layout_constraintEnd_toEndOf="@+id/rcv_LoaiHinh"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="@+id/rcv_LoaiHinh"
            app:layout_constraintTop_toBottomOf="@+id/rcv_LoaiHinh" />

        <Button
            android:id="@+id/btn_ApDung"
            android:layout_width="96dp"
            android:layout_height="37dp"
            android:layout_marginTop="56dp"
            android:backgroundTint="#0EA401"
            android:text="Áp dụng"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="@+id/rcv_NgonNgu"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toStartOf="@+id/rcv_NgonNgu"
            app:layout_constraintTop_toBottomOf="@+id/rcv_NgonNgu" />

        <Button
            android:id="@+id/btn_huy"
            android:layout_width="96dp"
            android:layout_height="37dp"
            android:layout_marginTop="56dp"
            android:backgroundTint="#3C3C3C"
            android:text="Hủy"
            android:textColor="#0C9300"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="@+id/rcv_NgonNgu"
            app:layout_constraintHorizontal_bias="0.508"
            app:layout_constraintStart_toStartOf="@+id/rcv_NgonNgu"
            app:layout_constraintTop_toBottomOf="@+id/rcv_NgonNgu" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcv_KyNangTrangHoSo"
            android:layout_width="330dp"
            android:layout_height="106dp"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="@+id/textView3"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="@+id/textView3"
            app:layout_constraintTop_toBottomOf="@+id/textView3" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcv_LoaiHinh"
            android:layout_width="330dp"
            android:layout_height="106dp"
            android:layout_marginTop="4dp"
            app:layout_constraintEnd_toEndOf="@+id/textView11"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="@+id/textView11"
            app:layout_constraintTop_toBottomOf="@+id/textView11" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcv_NgonNgu"
            android:layout_width="330dp"
            android:layout_height="106dp"
            android:layout_marginTop="4dp"
            app:layout_constraintEnd_toEndOf="@+id/textView12"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="@+id/textView12"
            app:layout_constraintTop_toBottomOf="@+id/textView12" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>