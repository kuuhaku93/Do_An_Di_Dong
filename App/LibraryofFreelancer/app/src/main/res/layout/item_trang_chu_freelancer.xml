<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- ConstraintLayout con: item freelancer -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_itemFreelancer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_item_trang_chu_freelancer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0">

        <!-- Ảnh đại diện -->
        <ImageView
            android:id="@+id/img_anhDaiDien__trangChuFreelancer_item"
            android:layout_width="88dp"
            android:layout_height="69dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:srcCompat="@tools:sample/avatars" />

        <!-- Tiêu đề -->
        <TextView
            android:id="@+id/txt_title_trangChuFreelancer_item"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:text="Tên Công Việc"
            android:textColor="#FDFDFD"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/img_anhDaiDien__trangChuFreelancer_item"
            app:layout_constraintTop_toTopOf="@id/img_anhDaiDien__trangChuFreelancer_item" />

        <!-- Nội dung mô tả -->
        <TextView
            android:id="@+id/txt_noiDung_trangChuFreelancer_item"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="10dp"
            android:text="Tên công ty"
            android:textColor="#FDFDFD"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/txt_title_trangChuFreelancer_item"
            app:layout_constraintTop_toBottomOf="@id/txt_title_trangChuFreelancer_item" />

        <!-- Icon và mức lương -->
        <ImageView
            android:id="@+id/imageView9"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="5dp"
            app:layout_constraintStart_toStartOf="@id/txt_noiDung_trangChuFreelancer_item"
            app:layout_constraintTop_toBottomOf="@id/txt_noiDung_trangChuFreelancer_item"
            app:srcCompat="@drawable/payments_24"
            app:tint="#0C9300" />

        <TextView
            android:id="@+id/txt_mucLuong_trangChuFreelancer_item"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:text="$500 – $1,000"
            android:textColor="#FAF7F7"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/imageView9"
            app:layout_constraintTop_toTopOf="@id/imageView9" />

        <!-- Icon và thời gian -->
        <ImageView
            android:id="@+id/imageView10"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="5dp"
            app:layout_constraintStart_toStartOf="@id/imageView9"
            app:layout_constraintTop_toBottomOf="@id/imageView9"
            app:srcCompat="@drawable/baseline_work_24"
            app:tint="#0C9300" />

        <TextView
            android:id="@+id/txt_thoiGianCongViec_trangChuFreelancer_item"
            android:layout_width="146dp"
            android:layout_height="24dp"
            android:layout_marginStart="5dp"
            android:layout_marginTop="4dp"
            android:text="9:00 1/1/2026"
            android:textColor="#FDFCFC"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toEndOf="@id/imageView10"
            app:layout_constraintTop_toBottomOf="@+id/txt_mucLuong_trangChuFreelancer_item" />

        <!-- Icon người và số lượng -->

        <!-- RecyclerView cho các tag -->

        <ImageView
            android:id="@+id/imageView12"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="50dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/txt_thoiGianCongViec_trangChuFreelancer_item"
            app:layout_constraintVertical_bias="0.0"
            app:srcCompat="@drawable/person_24"
            app:tint="#0C9300" />

        <TextView
            android:id="@+id/txt_soLuong_kyNagnTrangChuFreelanxer_item"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:text="TextView"
            android:textColor="#F6F3F3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.437"
            app:layout_constraintStart_toEndOf="@+id/imageView12"
            app:layout_constraintTop_toTopOf="@+id/imageView12" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rev_trangChuFreelancer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txt_thoiGianCongViec_trangChuFreelancer_item"
            app:layout_constraintVertical_bias="0.974" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>