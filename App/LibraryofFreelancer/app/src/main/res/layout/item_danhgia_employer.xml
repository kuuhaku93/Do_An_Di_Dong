<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_nguoiDanhGia"
        android:layout_width="411dp"
        android:layout_height="132dp"
        android:background="@drawable/bg_item_trang_chu_freelancer">

        <!-- Ảnh đại diện -->

        <TextView
            android:id="@+id/txt_ngayDanhGia_item"
            android:layout_width="168dp"
            android:layout_height="18dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="48dp"
            android:layout_marginBottom="4dp"
            android:text="Ngày đánh giá"
            android:textColor="#FDFDFD"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/img_anhDaiDien_NguoiDanhGia_item"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="@+id/img_anhDaiDien_NguoiDanhGia_item"
            app:layout_constraintTop_toBottomOf="@+id/img_anhDaiDien_NguoiDanhGia_item"
            app:layout_constraintVertical_bias="0.9" />

        <TextView
            android:id="@+id/txt_soSao_item"
            android:layout_width="52dp"
            android:layout_height="24dp"
            android:text="Số sao"
            android:textColor="#FDFDFD"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/img_anhDaiDien_NguoiDanhGia_item"
            app:layout_constraintTop_toTopOf="@+id/img_anhDaiDien_NguoiDanhGia_item"
            app:layout_constraintVertical_bias="0.488"
            tools:layout_editor_absoluteX="326dp" />

        <ImageView
            android:id="@+id/img_anhDaiDien_NguoiDanhGia_item"
            android:layout_width="88dp"
            android:layout_height="69dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:srcCompat="@tools:sample/avatars" />

        <!-- Tiêu đề -->

        <!-- Nội dung mô tả -->

        <TextView
            android:id="@+id/txt_title_item"
            android:layout_width="164dp"
            android:layout_height="19dp"
            android:layout_marginStart="16dp"
            android:text="Tên Người Đánh Giá"
            android:textColor="#FDFDFD"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toEndOf="@+id/img_anhDaiDien_NguoiDanhGia_item"
            app:layout_constraintTop_toTopOf="@+id/img_anhDaiDien_NguoiDanhGia_item" />

        <TextView
            android:id="@+id/txt_noiDung_item"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="48dp"
            android:text="Nội dung đánh giá"
            android:textColor="#FDFDFD"
            app:layout_constraintEnd_toEndOf="@+id/txt_title_item"
            app:layout_constraintStart_toStartOf="@id/txt_title_item"
            app:layout_constraintTop_toBottomOf="@+id/txt_title_item" />

        <TextView
            android:id="@+id/textView22"
            android:layout_width="16dp"
            android:layout_height="26dp"
            android:text="★"
            android:textColor="#FFD700"
            android:textSize="18sp"
            app:layout_constraintBottom_toBottomOf="@+id/txt_soSao_item"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/txt_soSao_item"
            app:layout_constraintTop_toTopOf="@+id/txt_soSao_item" />

        <!-- Icon và mức lương -->

        <!-- Icon và thời gian -->

        <!-- RecyclerView cho các tag -->

        <!-- Icon người và số lượng -->

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>