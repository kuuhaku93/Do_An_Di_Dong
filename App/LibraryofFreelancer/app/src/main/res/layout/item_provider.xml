<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="#050505">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ctlayout_applyJob_itemProvider_Employer"
        android:layout_width="409dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="5dp"
        android:background="#64DB15"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_item_provider_Employer"
            android:layout_width="396dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:layout_marginStart="2dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="2dp"
            android:layout_marginBottom="2dp"
            android:background="#000000"
            app:layout_constraintBottom_toBottomOf="@+id/ctlayout_applyJob_itemProvider_Employer"
            app:layout_constraintEnd_toEndOf="@+id/ctlayout_applyJob_itemProvider_Employer"
            app:layout_constraintStart_toStartOf="@+id/ctlayout_applyJob_itemProvider_Employer"
            app:layout_constraintTop_toTopOf="@+id/ctlayout_applyJob_itemProvider_Employer">

            <Button
                android:id="@+id/btn_duyet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="#0C9300"
                android:text="TUYỂN"
                android:textSize="10sp"
                app:layout_constraintEnd_toEndOf="@+id/textView25"
                app:layout_constraintHorizontal_bias="0.496"
                app:layout_constraintStart_toStartOf="@+id/txt_motacongviec"
                app:layout_constraintTop_toBottomOf="@+id/textView25" />

            <ImageView
                android:id="@+id/img_avatar_ItemProvider_Employer"
                android:layout_width="98dp"
                android:layout_height="122dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="5dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:srcCompat="@tools:sample/avatars" />

            <TextView
                android:id="@+id/txt_fullName_itemProvider_Employer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:text="TextView"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                app:layout_constraintEnd_toStartOf="@+id/txt_wantedsalary_itemProvider_Employer"
                app:layout_constraintStart_toEndOf="@+id/img_avatar_ItemProvider_Employer"
                app:layout_constraintTop_toTopOf="@+id/img_avatar_ItemProvider_Employer" />

            <TextView
                android:id="@+id/txt_message_itemProvide_Employer"
                android:layout_width="0dp"
                android:layout_height="53dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="5dp"
                android:text="TextView"
                android:textColor="#FFFEFE"
                android:textSize="12sp"
                app:layout_constraintEnd_toStartOf="@+id/btn_duyet"
                app:layout_constraintHorizontal_bias="0.481"
                app:layout_constraintStart_toStartOf="@+id/txt_fullName_itemProvider_Employer"
                app:layout_constraintTop_toBottomOf="@+id/txt_time_itemProvider_Employer" />

            <TextView
                android:id="@+id/txt_time_itemProvider_Employer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="TextView"
                android:textColor="#F4F4F4"
                app:layout_constraintEnd_toEndOf="@+id/txt_fullName_itemProvider_Employer"
                app:layout_constraintHorizontal_bias="0.372"
                app:layout_constraintStart_toStartOf="@+id/txt_fullName_itemProvider_Employer"
                app:layout_constraintTop_toBottomOf="@+id/txt_fullName_itemProvider_Employer" />

            <TextView
                android:id="@+id/textView25"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="8dp"
                android:textColor="#FFEB3B"
                android:textSize="34sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txt_wantedsalary_itemProvider_Employer"
                tools:text="★" />

            <TextView
                android:id="@+id/txt_review_itemProvider_Employer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:text="4"
                android:textColor="#FFC107"
                android:textSize="34sp"
                app:layout_constraintBottom_toBottomOf="@+id/textView25"
                app:layout_constraintEnd_toStartOf="@+id/textView25"
                app:layout_constraintTop_toTopOf="@+id/textView25"
                app:layout_constraintVertical_bias="1.0" />

            <TextView
                android:id="@+id/txt_wantedsalary_itemProvider_Employer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:text="400$"
                android:textAlignment="textEnd"
                android:textColor="#63D915"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/txt_fullName_itemProvider_Employer" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rev_skill_itemProvider_Employer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="10dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/img_avatar_ItemProvider_Employer"
                app:layout_constraintVertical_bias="0.111" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>