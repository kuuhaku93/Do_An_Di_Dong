<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".view.LichSuCongViecEmployerActivity">

    <ImageButton
        android:id="@+id/btn_QuayLaiTrangNutCaiDatFreelancer"
        android:layout_width="44dp"
        android:layout_height="41dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="@null"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/baseline_arrow_back_24"
        app:tint="#6C6C6C" />

    <TextView
        android:id="@+id/label_lichSuCongViec"
        android:layout_width="378dp"
        android:layout_height="70dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="68dp"
        android:text="Lịch sử công việc"
        android:textAlignment="center"
        android:textColor="#0D9501"
        android:textSize="40dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rec_lichSuCongViecEmployer"
        android:layout_width="0dp"
        android:layout_height="500dp"
        app:layout_constraintEnd_toEndOf="@+id/label_lichSuCongViec"
        app:layout_constraintStart_toStartOf="@+id/label_lichSuCongViec"
        app:layout_constraintTop_toBottomOf="@+id/label_lichSuCongViec" />
</androidx.constraintlayout.widget.ConstraintLayout>