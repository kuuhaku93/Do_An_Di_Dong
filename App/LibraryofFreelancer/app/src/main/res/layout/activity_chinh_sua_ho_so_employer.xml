<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1F1E1E"
    tools:context=".view.ChinhSuaHoSoEmployerActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Nút quay lại -->
        <ImageButton
            android:id="@+id/nut_quay_lai"
            android:layout_width="68dp"
            android:layout_height="53dp"
            android:layout_marginStart="32dp"
            android:layout_marginTop="34dp"
            android:background="@null"
            app:srcCompat="@drawable/baseline_arrow_back_24"
            app:tint="#6C6C6C"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Họ và tên -->
        <TextView
            android:id="@+id/nhan_ho_va_ten"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Họ và tên"
            android:textColor="#FFFFFF"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/nut_quay_lai"
            android:layout_marginStart="32dp"
            android:layout_marginTop="32dp"/>

        <EditText
            android:id="@+id/txt_nhaptencongty"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:background="@drawable/custom_txt"
            android:ems="10"
            android:inputType="text"
            android:paddingLeft="20dp"
            android:text="Họ và tên"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/nhan_ho_va_ten"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:layout_marginTop="8dp"/>

        <!-- Email -->
        <TextView
            android:id="@+id/nhan_email"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Email"
            android:textColor="#FFFFFF"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txt_nhaptencongty"
            android:layout_marginStart="32dp"
            android:layout_marginTop="16dp"/>

        <TextView
            android:id="@+id/nhan_diachi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="4dp"
            android:text="Địa chỉ"
            android:textColor="#FFFFFF"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/o_nhap_mo_ta" />

        <EditText
            android:id="@+id/txt_nhapemailcongty"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:background="@drawable/custom_txt"
            android:ems="10"
            android:inputType="textEmailAddress"
            android:paddingLeft="20dp"
            android:text="Email"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/nhan_email"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:layout_marginTop="8dp"/>

        <!-- SĐT -->
        <TextView
            android:id="@+id/nhan_sdt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="16dp"
            android:text="Website"
            android:textColor="#FFFFFF"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txt_nhapemailcongty" />

        <EditText
            android:id="@+id/txt_nhapwebsite"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_marginStart="32dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="32dp"
            android:background="@drawable/custom_txt"
            android:ems="10"
            android:inputType="phone"
            android:paddingLeft="20dp"
            android:text="Link website"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/nhan_sdt" />

        <!-- Học vấn -->

        <!-- Năm học -->

        <!-- Mô tả -->

        <EditText
            android:id="@+id/txt_chinhsuadiachi"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_marginStart="32dp"
            android:layout_marginTop="3dp"
            android:layout_marginEnd="32dp"
            android:background="@drawable/custom_txt"
            android:ems="10"
            android:inputType="phone"
            android:paddingLeft="20dp"
            android:text="Địa chỉ"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/nhan_diachi" />

        <TextView
            android:id="@+id/nhan_mo_ta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:layout_marginTop="16dp"
            android:text="Thông tin công ty"
            android:textColor="#FFFFFF"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txt_nhapwebsite" />

        <EditText
            android:id="@+id/o_nhap_mo_ta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="32dp"
            android:background="@drawable/custum_txt_mota"
            android:ems="10"
            android:inputType="textMultiLine"
            android:minHeight="100dp"
            android:paddingLeft="20dp"
            android:text="Mô tả "
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/nhan_mo_ta" />

        <!-- Nút lưu -->
        <Button
            android:id="@+id/btn_luuemployer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="#0C9300"
            android:text="Lưu"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.9"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txt_chinhsuadiachi" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>