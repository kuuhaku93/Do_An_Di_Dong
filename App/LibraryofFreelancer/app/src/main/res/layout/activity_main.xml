<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1B1C1C"
    tools:context=".view.MainActivity">

    <Button
        android:id="@+id/btn_dangNhap"
        android:layout_width="342dp"
        android:layout_height="68.61dp"
        android:backgroundTint="#0C9300"
        android:text="Đăng nhập"
        android:textSize="24sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.494"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/spn_vai_tro"
        app:layout_constraintVertical_bias="0.285" />

    <ImageView
        android:id="@+id/imageView4"
        android:layout_width="202dp"
        android:layout_height="149dp"
        android:layout_marginStart="102dp"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="107dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/logo" />

    <TextView
        android:id="@+id/textView5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="176dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="177dp"
        android:text="Đăng nhập"
        android:textColor="#EBE5E5"
        android:textSize="34sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView4" />

    <EditText
        android:id="@+id/edt_tai_khoan"
        android:paddingLeft="20dp"
        android:layout_width="342dp"
        android:layout_height="68.61dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/custom_txt"
        android:ems="10"
        android:hint="Tài khoản"
        android:inputType="text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView5" />

    <Spinner
        android:id="@+id/spn_vai_tro"
        android:paddingLeft="20dp"
        android:layout_width="342dp"
        android:layout_height="68.61dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/custom_txt"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edt_mat_khau" />

    <TextView
        android:id="@+id/txt_quen_mat_khau"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="277dp"
        android:layout_marginTop="16dp"
        android:text="Quên mật khẩu"
        android:textColor="#15FF00"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="@+id/spn_vai_tro"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/spn_vai_tro" />

    <TextView
        android:id="@+id/txt_dang_ky"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Bạn chưa có tài khoản?"
        android:textColor="#FFE100"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="@+id/btn_dangNhap"
        app:layout_constraintTop_toBottomOf="@+id/btn_dangNhap" />

    <EditText
        android:id="@+id/edt_mat_khau"
        android:paddingLeft="20dp"
        android:layout_width="342dp"
        android:layout_height="68.61dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/custom_txt"
        android:ems="10"
        android:hint="Mật khẩu"
        android:inputType="textPassword"
        android:password="true"
        app:layout_constraintEnd_toEndOf="@+id/edt_tai_khoan"
        app:layout_constraintStart_toStartOf="@+id/edt_tai_khoan"
        app:layout_constraintTop_toBottomOf="@+id/edt_tai_khoan" />

</androidx.constraintlayout.widget.ConstraintLayout>