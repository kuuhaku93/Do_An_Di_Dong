<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1B1C1C">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dialog_chinhSuaLogo"
        android:layout_width="366dp"
        android:layout_height="wrap_content"
        android:background="@drawable/alerdialog_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <EditText
            android:id="@+id/txt_logo_ChinhSuaHoSo_employer"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="50dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/custom_txt"
            android:ems="10"
            android:inputType="text"
            android:paddingLeft="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/btn_ApDung_chinhSuaHoSo_Employer"
            android:layout_width="96dp"
            android:layout_height="37dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="10dp"
            android:backgroundTint="#0EA401"
            android:text="Áp dụng"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txt_logo_ChinhSuaHoSo_employer" />

        <Button
            android:id="@+id/btn_huy_chinhSuaHoSo_Employer"
            android:layout_width="96dp"
            android:layout_height="37dp"
            android:layout_marginEnd="30dp"
            android:backgroundTint="#3C3C3C"
            android:text="Hủy"
            android:textColor="#0C9300"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@+id/btn_ApDung_chinhSuaHoSo_Employer"
            app:layout_constraintEnd_toStartOf="@+id/btn_ApDung_chinhSuaHoSo_Employer" />

        <TextView
            android:id="@+id/textView27"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="Đường dẫn Logo"
            android:textColor="#FBFAFA"
            app:layout_constraintBottom_toTopOf="@+id/txt_logo_ChinhSuaHoSo_employer"
            app:layout_constraintStart_toStartOf="@+id/txt_logo_ChinhSuaHoSo_employer" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>