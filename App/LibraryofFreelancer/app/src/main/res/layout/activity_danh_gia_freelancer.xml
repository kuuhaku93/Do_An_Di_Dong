<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1B1C1C"
    tools:context=".view.employer.DanhGiaFreelancerActivity">

    <TextView
        android:id="@+id/textView7"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Đánh giá Freelancer"
        android:textColor="#0D9501"
        android:textSize="36sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <RatingBar
        android:id="@+id/rb_rating_danhGiaFreelancer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:numStars="5"
        android:progressTint="#FFC300"
        android:stepSize="1"
        app:layout_constraintEnd_toEndOf="@+id/txt_tenFreelancer_DanhGiaFreelancer"
        app:layout_constraintStart_toStartOf="@+id/txt_tenFreelancer_DanhGiaFreelancer"
        app:layout_constraintTop_toBottomOf="@+id/txt_tenFreelancer_DanhGiaFreelancer" />

    <ImageView
        android:id="@+id/img_anhDaiDien_DanhGiaFreelancer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="@+id/textView7"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="@+id/textView7"
        app:layout_constraintTop_toBottomOf="@+id/textView7"
        tools:srcCompat="@tools:sample/avatars" />

    <TextView
        android:id="@+id/txt_tenFreelancer_DanhGiaFreelancer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="TextView"
        android:textColor="#ffff"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="@+id/img_anhDaiDien_DanhGiaFreelancer"
        app:layout_constraintStart_toStartOf="@+id/img_anhDaiDien_DanhGiaFreelancer"
        app:layout_constraintTop_toBottomOf="@+id/img_anhDaiDien_DanhGiaFreelancer" />

    <EditText
        android:id="@+id/txt_danh_gia_freelancer"
        android:layout_width="wrap_content"
        android:layout_height="246dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/custum_txt_mota"
        android:ems="10"
        android:inputType="text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.492"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView10" />

    <TextView
        android:id="@+id/textView10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Viết đánh giá"
        android:textColor="#FFFAFA"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.116"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rb_rating_danhGiaFreelancer" />

    <Button
        android:id="@+id/btn_dang_danh_gia_freelancer"
        android:layout_width="342dp"
        android:layout_height="68.61dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#0C9300"
        android:text="ĐĂNG"
        android:textColorLink="#0C9300"
        android:textSize="16dp"
        app:layout_constraintEnd_toEndOf="@+id/txt_danh_gia_freelancer"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/txt_danh_gia_freelancer"
        app:layout_constraintTop_toBottomOf="@+id/txt_danh_gia_freelancer" />

</androidx.constraintlayout.widget.ConstraintLayout>